# ADui SCADA V0.2: ONE repository-root .env for local Web, Node services and Docker.
# Copy to .env (ignored by Git). No credentials, tokens or PLC addresses here.
# Frontend build options (do not add secret values to VITE_* variables).
SCADA_WEB_HOST=127.0.0.1
SCADA_REACT_DEV_PORT=5173
SCADA_VUE_DEV_PORT=5174

# Local NestJS /health and unauthenticated SSE simulator (loopback only).
SCADA_SERVER_HOST=127.0.0.1
SCADA_SERVER_PORT=3001
SCADA_DEMO_HOST=127.0.0.1
SCADA_DEMO_PORT=4178

# Docker Compose only: published HTTP ports remain on 127.0.0.1.
SCADA_REACT_PORT=8080
SCADA_VUE_PORT=8081
