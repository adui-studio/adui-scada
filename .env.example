# ADui SCADA V0.2：本地 Web、Node 服务和 Docker 统一使用仓库根目录的 .env。
# 复制为 .env（已被 Git 忽略），严禁写入凭据、令牌或真实 PLC 地址。
# 前端构建参数：不要在 VITE_* 变量中保存任何敏感信息。
SCADA_WEB_HOST=127.0.0.1
SCADA_REACT_DEV_PORT=15173
SCADA_VUE_DEV_PORT=15174

# 本地 NestJS /health 与无鉴权 SSE 模拟器，仅允许本机回环访问。
SCADA_SERVER_HOST=127.0.0.1
SCADA_SERVER_PORT=13001
# 日志等级仅允许 fatal/error/warn/info/debug/trace/silent，生产建议 info。
SCADA_LOG_LEVEL=info
# API 文档默认完全关闭；仅非生产并绑定 127.0.0.1 时允许显式启用。
SCADA_API_DOCS_ENABLED=false
SCADA_DEMO_HOST=127.0.0.1
SCADA_DEMO_PORT=14178

# 仅供 Docker Compose 使用：对宿主机发布的 HTTP 端口始终绑定 127.0.0.1。
SCADA_REACT_PORT=8080
SCADA_VUE_PORT=18081

# PostgreSQL 17 本地开发默认配置；数据库仅绑定本机，不用于生产。
# 主机为宿主机访问地址；Docker Compose 的端口仍强制绑定 127.0.0.1。
SCADA_DB_HOST=127.0.0.1
SCADA_DB_PORT=15432
SCADA_DB_NAME=adui_scada
SCADA_DB_USER=adui_scada

# 以下是公开的本地开发测试凭据，仅适用于回环地址的隔离开发数据库。
# 正式部署前必须更换密码及连接地址，不能直接沿用该示例。
SCADA_DB_PASSWORD=adui_scada_dev_only_2026

# Prisma 7 数据库连接串与上述默认用户名、密码、地址及库名一致。
# 修改密码后请同步修改本连接串；特殊字符须先进行 URL 编码。
SCADA_DATABASE_URL=postgresql://adui_scada:adui_scada_dev_only_2026@127.0.0.1:15432/adui_scada?schema=public
