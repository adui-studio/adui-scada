# ADui SCADA V0.2：本地 Web、Node 服务和 Docker 统一使用仓库根目录的 .env。
# 复制为 .env（已被 Git 忽略），严禁写入凭据、令牌或真实 PLC 地址。
# 前端构建参数：不要在 VITE_* 变量中保存任何敏感信息。
SCADA_WEB_HOST=127.0.0.1
SCADA_REACT_DEV_PORT=5173
SCADA_VUE_DEV_PORT=5174

# 本地 NestJS /health 与无鉴权 SSE 模拟器，仅允许本机回环访问。
SCADA_SERVER_HOST=127.0.0.1
SCADA_SERVER_PORT=3001
SCADA_DEMO_HOST=127.0.0.1
SCADA_DEMO_PORT=4178

# 仅供 Docker Compose 使用：对宿主机发布的 HTTP 端口始终绑定 127.0.0.1。
SCADA_REACT_PORT=8080
SCADA_VUE_PORT=8081

# PostgreSQL 17 本地开发默认配置；数据库仅绑定本机，不用于生产。
# 主机为宿主机访问地址；Docker Compose 的端口仍强制绑定 127.0.0.1。
SCADA_DB_HOST=127.0.0.1
SCADA_DB_PORT=5432
SCADA_DB_NAME=adui_scada
SCADA_DB_USER=adui_scada

# 不在公开仓库提供固定密码；复制为 .env 后自行设置强密码。
SCADA_DB_PASSWORD=

# Prisma 7 数据库连接串；需与上面的账号、密码、端口和数据库名保持一致。
# 密码含特殊字符时须按 URL 规则编码；示例仅供参考，不要原样用于生产。
# SCADA_DATABASE_URL=postgresql://adui_scada:经URL编码的密码@127.0.0.1:5432/adui_scada?schema=public
SCADA_DATABASE_URL=
