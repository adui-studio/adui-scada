# ADui SCADA V0.2：本地 Web、Node 服务和 Docker 统一使用仓库根目录的 .env。
# 复制为 .env（已被 Git 忽略），严禁写入凭据、令牌或真实 PLC 地址。
# 前端构建参数：不要在 VITE_* 变量中保存任何敏感信息。
SCADA_WEB_HOST=127.0.0.1
SCADA_REACT_DEV_PORT=15173
SCADA_VUE_DEV_PORT=15174

# 本地 NestJS /health 与无鉴权 SSE 模拟器，仅允许本机回环访问。
SCADA_SERVER_HOST=127.0.0.1
SCADA_SERVER_PORT=13001
# 日志等级仅允许 fatal/error/warn/info/debug/trace/silent，生产建议 info。
SCADA_LOG_LEVEL=info
# API 文档默认完全关闭；仅非生产并绑定 127.0.0.1 时允许显式启用。
SCADA_API_DOCS_ENABLED=false
# 仅开发且绑定 127.0.0.1 时允许显式启用 NestJS 只读模拟 Tag/SSE；生产始终关闭。
SCADA_LOCAL_DEMO_API_ENABLED=false
SCADA_DEMO_HOST=127.0.0.1
SCADA_DEMO_PORT=14178

# 仅供 Docker Compose 使用：对宿主机发布的 HTTP 端口始终绑定 127.0.0.1。
SCADA_REACT_PORT=18080
SCADA_VUE_PORT=18081

# 唯一本机 PostgreSQL 17 实例：保留已存在的 SCADA 身份与 Keycloak 数据。
# 数据库物理存储复用已完成迁移的测试数据卷；不要连接旧 15432 开发库。
# 主机为宿主机访问地址；Docker Compose 的端口仍强制绑定 127.0.0.1。
SCADA_DB_HOST=127.0.0.1
SCADA_DB_PORT=15432
SCADA_DB_NAME=adui_scada_oidc_lab
SCADA_DB_USER=adui_scada_oidc_lab

# 公开模板不预置真实数据库密码。Docker 启动使用本机随机凭据文件。
# 实际需要启用 NestJS OIDC 时，由维护者从本机秘密文件安全填写密码。
SCADA_DB_PASSWORD=

# 默认 OIDC 关闭时不需要数据库连接串；Prisma generate/validate 可离线执行。
# 联调前请指向本机 15433 的 adui_scada_oidc_lab，密码需 URL 编码。
SCADA_DATABASE_URL=

# 第三十三批 OIDC：默认关闭；仅在完整配置并显式启用后挂载受保护的身份及工程 API。
SCADA_OIDC_ENABLED=false
# 仅供非生产本机回环 HTTP Mock Issuer 测试；生产必须关闭。
SCADA_OIDC_ALLOW_INSECURE_LOOPBACK=false
# 下列值仅在 SCADA_OIDC_ENABLED=true 时必填，真实凭据必须由运行环境安全提供。
SCADA_OIDC_ISSUER=
SCADA_OIDC_CLIENT_ID=
SCADA_OIDC_CLIENT_SECRET=
# 必须精确指向 /api/v1/auth/oidc/callback。
SCADA_OIDC_REDIRECT_URI=
# 逗号分隔的可信 Web Origin，不允许路径或通配符。
SCADA_OIDC_WEB_ORIGINS=
# 32 字节强随机数的 Base64URL 编码；禁止提交真实密钥。
SCADA_OIDC_TRANSACTION_ENCRYPTION_KEY=

# 第三十三批第九小批：仅本机 Vite serve 显式启用 HTTPS + /api/v1 同源代理。
# 证书必须由维护者在仓库外自行配置并信任；不要提交证书或私钥。
SCADA_OIDC_DEV_HTTPS_ENABLED=false
SCADA_OIDC_DEV_HTTPS_CERT_FILE=
SCADA_OIDC_DEV_HTTPS_KEY_FILE=

# 唯一 Docker Compose 项目名称固定为 adui-scada；仅发布本机回环端口。
# 复制本文件为 .env 后运行 pnpm run docker:up（首次旧项目迁移见 docker:plan）。
# 首次启动脚本会创建忽略 Git 的本机随机密码与 mkcert 证书；不会写入公开模板。
# 内部 SCADA_LAB_* 变量保留以兼容现有本机证书与凭据；不另启第二套 PostgreSQL。
SCADA_LAB_KEYCLOAK_PORT=18443
SCADA_LAB_POSTGRES_PORT=15433
SCADA_LAB_REDIS_PORT=16379
