// ADui SCADA 服务端工程持久化；与浏览器 IndexedDB 草稿及正式发布指针分离。
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 服务端工程与其最新版本水位；0 表示该工程尚无版本。
model ScadaProject {
  tenantId     String                 @map("tenant_id") @db.VarChar(128)
  projectId    String                 @map("project_id") @db.VarChar(128)
  headRevision BigInt                 @default(0) @map("head_revision")
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  grants       ScadaProjectGrant[]
  versions     ScadaProjectVersion[]

  @@id([tenantId, projectId])
  @@map("scada_projects")
}

/// 逐主体逐操作授权，权限不从客户端请求体读取。
model ScadaProjectGrant {
  tenantId  String       @map("tenant_id") @db.VarChar(128)
  projectId String       @map("project_id") @db.VarChar(128)
  subjectId String       @map("subject_id") @db.VarChar(128)
  permission String      @db.Text
  project   ScadaProject @relation(fields: [tenantId, projectId], references: [tenantId, projectId], onDelete: Restrict)

  @@id([tenantId, projectId, subjectId, permission])
  @@index([tenantId, subjectId, projectId], map: "scada_project_grants_subject_idx")
  @@map("scada_project_grants")
}

/// 只追加 SHA-256 工程版本快照，正式发布另有独立流程。
model ScadaProjectVersion {
  tenantId    String              @map("tenant_id") @db.VarChar(128)
  projectId   String              @map("project_id") @db.VarChar(128)
  revision    BigInt
  snapshot    Json                @db.JsonB
  contentHash String              @map("content_hash") @db.VarChar(64)
  createdBy   String              @map("created_by") @db.VarChar(128)
  createdAt   DateTime            @map("created_at") @db.Timestamptz(6)
  project     ScadaProject        @relation(fields: [tenantId, projectId], references: [tenantId, projectId], onDelete: Restrict)
  audit       ScadaProjectAudit?

  @@id([tenantId, projectId, revision])
  @@index([tenantId, projectId, createdAt], map: "scada_project_versions_created_idx")
  @@map("scada_project_versions")
}

/// 成功保存审计与版本一对一；失败尝试的独立安全审计暂未实现。
model ScadaProjectAudit {
  eventId   String              @id @default(uuid()) @map("event_id") @db.Uuid
  tenantId  String              @map("tenant_id") @db.VarChar(128)
  projectId String              @map("project_id") @db.VarChar(128)
  revision  BigInt
  actorId   String              @map("actor_id") @db.VarChar(128)
  action    String              @db.Text
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  version   ScadaProjectVersion @relation(fields: [tenantId, projectId, revision], references: [tenantId, projectId, revision], onDelete: Restrict)

  @@unique([tenantId, projectId, revision], map: "scada_project_audit_version_key")
  @@index([tenantId, actorId, createdAt], map: "scada_project_audit_actor_idx")
  @@map("scada_project_audit")
}
