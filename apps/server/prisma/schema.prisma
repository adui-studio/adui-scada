// ADui SCADA 服务端工程持久化；与浏览器 IndexedDB 草稿及正式发布指针分离。
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 服务端工程与其最新版本水位；0 表示该工程尚无版本。
model ScadaProject {
  /// 所属租户标识，与工程标识共同构成联合主键。
  tenantId     String                 @map("tenant_id") @db.VarChar(128)
  /// 工程标识，在同一租户内唯一。
  projectId    String                 @map("project_id") @db.VarChar(128)
  /// 最新历史版本修订号；0 表示尚无已保存版本。
  headRevision BigInt                 @default(0) @map("head_revision")
  /// 工程创建时间，采用带时区时间戳。
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 工程最近修改时间，版本更新时由 Prisma 维护。
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// 该工程的主体级操作授权列表。
  grants       ScadaProjectGrant[]
  /// 该工程只追加的历史版本集合。
  versions     ScadaProjectVersion[]

  @@id([tenantId, projectId])
  @@map("scada_projects")
}

/// 逐主体逐操作授权，权限不从客户端请求体读取。
model ScadaProjectGrant {
  /// 授权记录所属租户标识。
  tenantId  String       @map("tenant_id") @db.VarChar(128)
  /// 授权记录所属工程标识。
  projectId String       @map("project_id") @db.VarChar(128)
  /// 被授权的可信身份主体标识。
  subjectId String       @map("subject_id") @db.VarChar(128)
  /// 明确授予的工程读取、版本读取或版本追加权限。
  permission String      @db.Text
  /// 该授权记录所属的工程主表记录。
  project   ScadaProject @relation(fields: [tenantId, projectId], references: [tenantId, projectId], onDelete: Restrict)

  @@id([tenantId, projectId, subjectId, permission])
  @@index([tenantId, subjectId, projectId], map: "scada_project_grants_subject_idx")
  @@map("scada_project_grants")
}

/// 只追加 SHA-256 工程版本快照，正式发布另有独立流程。
model ScadaProjectVersion {
  /// 历史版本所属租户标识。
  tenantId    String              @map("tenant_id") @db.VarChar(128)
  /// 历史版本所属工程标识。
  projectId   String              @map("project_id") @db.VarChar(128)
  /// 服务端分配的递增修订号，范围为正安全整数。
  revision    BigInt
  /// 完整工程快照，包含格式、文档、修订号和内容摘要。
  snapshot    Json                @db.JsonB
  /// 快照 SHA-256 小写十六进制摘要，用于校验完整性。
  contentHash String              @map("content_hash") @db.VarChar(64)
  /// 本次版本保存的可信操作主体标识。
  createdBy   String              @map("created_by") @db.VarChar(128)
  /// 工程版本创建时间，采用带时区时间戳。
  createdAt   DateTime            @map("created_at") @db.Timestamptz(6)
  /// 此历史版本所属的工程。
  project     ScadaProject        @relation(fields: [tenantId, projectId], references: [tenantId, projectId], onDelete: Restrict)
  /// 该成功保存版本对应的审计事件。
  audit       ScadaProjectAudit?

  @@id([tenantId, projectId, revision])
  @@index([tenantId, projectId, createdAt], map: "scada_project_versions_created_idx")
  @@map("scada_project_versions")
}

/// 成功保存审计与版本一对一；失败尝试的独立安全审计暂未实现。
model ScadaProjectAudit {
  /// 审计事件全局唯一 UUID 标识。
  eventId   String              @id @default(uuid()) @map("event_id") @db.Uuid
  /// 成功保存事件所属租户标识。
  tenantId  String              @map("tenant_id") @db.VarChar(128)
  /// 成功保存事件所属工程标识。
  projectId String              @map("project_id") @db.VarChar(128)
  /// 本次成功保存的工程修订号。
  revision  BigInt
  /// 执行版本追加操作的可信主体标识。
  actorId   String              @map("actor_id") @db.VarChar(128)
  /// 审计操作类型，当前仅允许版本追加。
  action    String              @db.Text
  /// 成功提交审计事件创建时间。
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 该审计事件对应的不可变工程版本。
  version   ScadaProjectVersion @relation(fields: [tenantId, projectId, revision], references: [tenantId, projectId, revision], onDelete: Restrict)

  @@unique([tenantId, projectId, revision], map: "scada_project_audit_version_key")
  @@index([tenantId, actorId, createdAt], map: "scada_project_audit_actor_idx")
  @@map("scada_project_audit")
}

/// 已验证的租户内主体；不保存前端提供的角色、令牌明文或本地密码。
model ScadaIdentity {
  /// 主体所属租户的服务端标识。
  tenantId  String             @map("tenant_id") @db.VarChar(128)
  /// 主体唯一标识，由后续可信身份提供方关联。
  subjectId String             @map("subject_id") @db.VarChar(128)
  /// 主体状态，仅 active 可获得访问授权。
  status    String             @default("active") @db.VarChar(16)
  /// 主体创建时间。
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 主体记录最后更新时间。
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// 该主体的短期服务端会话集合。
  sessions  ScadaAuthSession[]
  /// 该主体预绑定的 OIDC 外部身份集合。
  externalIdentities ScadaExternalIdentity[]

  @@id([tenantId, subjectId])
  @@map("scada_identities")
}

/// 短期服务端令牌会话，只存储高熵令牌 SHA-256 摘要，支持即时撤销。
model ScadaAuthSession {
  /// 会话主键，保留 PostgreSQL 原生 UUID 类型。
  sessionId String        @id @default(uuid()) @map("session_id") @db.Uuid
  /// 会话归属租户标识，必须与主体所属租户一致。
  tenantId  String        @map("tenant_id") @db.VarChar(128)
  /// 会话归属的可信主体标识。
  subjectId String        @map("subject_id") @db.VarChar(128)
  /// 不透明高熵令牌的 SHA-256 摘要，绝不存储令牌明文。
  tokenHash String        @unique(map: "scada_auth_sessions_token_hash_key") @map("token_hash") @db.VarChar(64)
  /// 会话创建时间。
  issuedAt  DateTime      @default(now()) @map("issued_at") @db.Timestamptz(6)
  /// 会话严格过期时间，不允许无限续期。
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(6)
  /// 会话显式撤销时间；为空表示尚未撤销。
  revokedAt DateTime?     @map("revoked_at") @db.Timestamptz(6)
  /// 浏览器 Cookie 会话的 CSRF 令牌摘要；旧 Bearer 会话允许为空。
  csrfTokenHash String?  @map("csrf_token_hash") @db.VarChar(64)
  /// 该会话关联的租户内可信主体。
  identity  ScadaIdentity @relation(fields: [tenantId, subjectId], references: [tenantId, subjectId], onDelete: Restrict)

  @@index([tenantId, subjectId, expiresAt], map: "scada_auth_sessions_subject_expiry_idx")
  @@map("scada_auth_sessions")
}


/// 经过受信运维流程预绑定的外部 OIDC 身份；邮箱与角色声明不作为主体主键。
model ScadaExternalIdentity {
  /// 经过服务端配置和 Discovery 校验的固定 OIDC Issuer。
  issuer String @db.VarChar(512)
  /// OIDC Issuer 内唯一的 subject，不允许通过邮箱或用户名替代。
  subject String @db.VarChar(256)
  /// 该外部身份映射到的本地租户标识。
  tenantId String @map("tenant_id") @db.VarChar(128)
  /// 该外部身份映射到的租户内可信主体标识。
  subjectId String @map("subject_id") @db.VarChar(128)
  /// 预绑定记录创建时间。
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 只能映射到已经建立的本地可信主体。
  identity ScadaIdentity @relation(fields: [tenantId, subjectId], references: [tenantId, subjectId], onDelete: Restrict)

  @@id([issuer, subject])
  @@index([tenantId, subjectId], map: "scada_external_identities_identity_idx")
  @@map("scada_external_identities")
}

/// 一次性 OIDC 登录事务：不存储 PKCE verifier 明文、授权码或任何 IdP Token。
model ScadaOidcTransaction {
  /// 高熵 state 的 SHA-256 小写十六进制摘要，用作一次性主键。
  stateHash String @id @map("state_hash") @db.VarChar(64)
  /// 创建登录事务时固定的 OIDC Issuer。
  issuer String @db.VarChar(512)
  /// 仅用于验证回调 ID Token 的 nonce，不是账号身份。
  nonce String @db.VarChar(128)
  /// AES-256-GCM 加密后的 PKCE verifier 密文及所需解密参数。
  verifierCiphertext String @map("verifier_ciphertext") @db.Text
  /// 绑定发起登录浏览器的随机 Cookie SHA-256 摘要。
  browserBindingHash String @map("browser_binding_hash") @db.VarChar(64)
  /// 校验过的站内相对跳转路径，禁止外部重定向。
  returnPath String @map("return_path") @db.VarChar(1024)
  /// 登录事务创建时间。
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 登录事务绝对过期时间，默认应用层设为五分钟。
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  /// 原子消费时间；为空表示尚未消费。
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)

  @@index([expiresAt, consumedAt], map: "scada_oidc_transactions_expiry_idx")
  @@index([browserBindingHash, expiresAt], map: "scada_oidc_transactions_browser_idx")
  @@map("scada_oidc_transactions")
}
