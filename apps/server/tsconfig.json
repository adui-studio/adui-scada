{
  "extends": "@adui/tsconfig/nest",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "types": [
      "node"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "vitest.config*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
