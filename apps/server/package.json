{
  "name": "@adui/scada-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @adui/scada-core run build:node && pnpm run db:generate && nest build",
    "typecheck": "pnpm --filter @adui/scada-core run build:node && pnpm run db:generate && tsc --noEmit -p tsconfig.json",
    "start": "pnpm --filter @adui/scada-core run build:node && pnpm run db:generate && nest start",
    "start:dev": "pnpm --filter @adui/scada-core run build:node && pnpm run db:generate && nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "vp test run --config vitest.config.ts",
    "test:watch": "vp test --config vitest.config.ts",
    "test:e2e": "vp test run --config vitest.config.e2e.ts",
    "db:validate": "prisma7 validate --config prisma7.config.ts",
    "db:generate": "prisma7 generate --config prisma7.config.ts && node prisma8-fresh-install.mjs --runtime-emit",
    "db:migrate:dev": "prisma7 migrate dev --config prisma7.config.ts",
    "db:migrate:deploy": "prisma7 migrate deploy --config prisma7.config.ts",
    "db:migrate:status": "prisma7 migrate status --config prisma7.config.ts",
    "test:db": "pnpm --filter @adui/scada-core run build:node && pnpm run db:generate && vp test run --config vitest.config.db.ts",
    "db:prisma8:emit": "node ../../scripts/prisma8-cli.mjs contract emit"
  },
  "dependencies": {
    "@adui/scada-core": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/terminus": "catalog:",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "@prisma/orm-postgres": "catalog:",
    "helmet": "catalog:",
    "nestjs-pino": "catalog:",
    "openid-client": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@adui/tsconfig": "workspace:*",
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@prisma/prisma7": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/supertest": "catalog:",
    "pino-pretty": "catalog:",
    "prisma": "catalog:",
    "supertest": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
