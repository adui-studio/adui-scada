{
  "name": "@adui/scada-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "vp test run --config vitest.config.ts",
    "test:watch": "vp test --config vitest.config.ts",
    "test:e2e": "vp test run --config vitest.config.e2e.ts",
    "db:validate": "prisma validate --config prisma.config.ts",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:migrate:dev": "prisma migrate dev --config prisma.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "db:migrate:status": "prisma migrate status --config prisma.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "pg": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@adui/tsconfig": "workspace:*",
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/supertest": "catalog:",
    "prisma": "catalog:",
    "supertest": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
