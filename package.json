{
  "name": "adui-scada",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run dev:demo",
    "dev:demo": "node --experimental-strip-types examples/water-treatment/server.mjs",
    "dev:react": "vp -C apps/web-react dev",
    "dev:vue": "vp -C apps/web-vue dev",
    "build:web": "vp -C apps/web-react build && vp -C apps/web-vue build",
    "typecheck:web": "pnpm --filter @adui/scada-web-react run typecheck && pnpm --filter @adui/scada-web-vue run typecheck && pnpm --filter @adui/scada-draft-storage run typecheck",
    "test": "pnpm run build:core && vp test run",
    "test:unit": "pnpm run build:core && pnpm run db:generate && vp test run",
    "test:browser": "node scripts/test-studio-browser.mjs",
    "test:sse:browser": "node scripts/test-runtime-sse-browser.mjs",
    "test:sse:clients": "node --test examples/water-treatment/sse-clients.test.mjs",
    "test:sse:network": "node scripts/test-runtime-sse-network.mjs",
    "test:sse:proxy": "node scripts/test-runtime-sse-network.mjs --proxy",
    "test:interop": "node scripts/test-studio-browser.mjs --interop",
    "test:versions": "node scripts/test-studio-browser.mjs --versions",
    "test:versions:safety": "node scripts/test-studio-browser.mjs --versions-safety",
    "test:multitab": "node scripts/test-studio-browser.mjs --multitab",
    "test:core": "pnpm run build:core && vp test run packages/core/test",
    "test:runtime": "pnpm run build:core && vp test run packages/runtime/test",
    "deps:check": "node scripts/check-dependency-catalog.mjs",
    "docs:check": "node scripts/validate-docs.mjs",
    "ready": "pnpm run deps:check && pnpm run config:check && pnpm run env:check && pnpm run messages:check && pnpm run db:generate && pnpm run build:core && vp check && pnpm run typecheck:web && pnpm run typecheck:server && pnpm run test:unit && pnpm run test:sse:clients && pnpm run test:e2e:server && pnpm run docs:check && pnpm run build:web && pnpm run build:server",
    "prepare": "pnpm run build:core && vp config",
    "dev:server": "pnpm --filter @adui/scada-server run start:dev",
    "build:server": "pnpm --filter @adui/scada-server run build",
    "typecheck:server": "pnpm --filter @adui/scada-server run typecheck",
    "test:server": "pnpm --filter @adui/scada-server run test",
    "test:e2e:server": "pnpm --filter @adui/scada-server run test:e2e",
    "desktop:dev:react": "pnpm --filter @adui/scada-desktop run dev:react",
    "desktop:dev:vue": "pnpm --filter @adui/scada-desktop run dev:vue",
    "desktop:build:react": "pnpm --filter @adui/scada-desktop run build:react",
    "desktop:build:vue": "pnpm --filter @adui/scada-desktop run build:vue",
    "config:check": "node scripts/check-shared-config.mjs",
    "desktop:build:react:msi": "pnpm --filter @adui/scada-desktop run build:react:msi",
    "desktop:build:vue:msi": "pnpm --filter @adui/scada-desktop run build:vue:msi",
    "docker:demo:up": "docker compose -f deploy/docker/compose.demo.yaml up --build -d",
    "docker:demo:down": "docker compose -f deploy/docker/compose.demo.yaml down",
    "docker:demo:logs": "docker compose -f deploy/docker/compose.demo.yaml logs -f",
    "env:check": "node scripts/check-env-config.mjs",
    "messages:check": "node scripts/check-chinese-messages.mjs",
    "db:validate": "pnpm --filter @adui/scada-server run db:validate",
    "db:generate": "pnpm --filter @adui/scada-server run db:generate",
    "db:migrate:dev": "pnpm --filter @adui/scada-server run db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @adui/scada-server run db:migrate:deploy",
    "db:migrate:status": "pnpm --filter @adui/scada-server run db:migrate:status",
    "db:dev:up": "pnpm run env:check && docker compose --env-file .env -f deploy/docker/compose.postgres.dev.yaml up -d",
    "db:dev:down": "docker compose --env-file .env -f deploy/docker/compose.postgres.dev.yaml down",
    "test:db": "pnpm --filter @adui/scada-server run test:db",
    "build:core": "pnpm --filter @adui/scada-core run build:node",
    "test:docker:server": "node scripts/test-server-container.mjs"
  },
  "devDependencies": {
    "@adui/tooling": "workspace:*",
    "@adui/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
