{
  "name": "adui-scada",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:check": "node scripts/validate-docs.mjs",
    "test:core": "node --experimental-strip-types --test packages/core/test/document.test.ts packages/core/test/tag-store.test.ts packages/core/test/svg.test.ts",
    "ready": "vp check && pnpm run test:core && pnpm run docs:check",
    "dev": "pnpm run dev:demo",
    "dev:demo": "node --experimental-strip-types examples/water-treatment/server.mjs",
    "prepare": "vp config"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
