{
  "name": "adui-scada",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run dev:demo",
    "dev:demo": "node --experimental-strip-types examples/water-treatment/server.mjs",
    "dev:react": "vp -C apps/web-react dev",
    "dev:vue": "vp -C apps/web-vue dev",
    "build:web": "vp -C apps/web-react build && vp -C apps/web-vue build",
    "typecheck:web": "pnpm --filter @adui/scada-web-react run typecheck && pnpm --filter @adui/scada-web-vue run typecheck",
    "test": "vp test run",
    "test:unit": "vp test run",
    "test:core": "vp test run packages/core/test",
    "test:runtime": "vp test run packages/runtime/test",
    "deps:check": "node scripts/check-dependency-catalog.mjs",
    "docs:check": "node scripts/validate-docs.mjs",
    "ready": "pnpm run deps:check && vp check && pnpm run typecheck:web && pnpm run test:unit && pnpm run docs:check && pnpm run build:web",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
