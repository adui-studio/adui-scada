{
  "name": "adui-scada",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run dev:demo",
    "dev:demo": "node --experimental-strip-types examples/water-treatment/server.mjs",
    "dev:react": "vp -C apps/web-react dev",
    "dev:vue": "vp -C apps/web-vue dev",
    "build:web": "vp -C apps/web-react build && vp -C apps/web-vue build",
    "typecheck:web": "pnpm --filter @adui/scada-web-react run typecheck && pnpm --filter @adui/scada-web-vue run typecheck && pnpm --filter @adui/scada-draft-storage run typecheck && pnpm --filter @adui/scada-api-client run typecheck",
    "test": "pnpm run build:core && vp test run",
    "test:unit": "pnpm run build:core && pnpm run db:generate && vp test run",
    "test:browser": "node scripts/test-studio-browser.mjs",
    "test:tags:browser": "node scripts/test-studio-browser.mjs --tags",
    "test:legacy:browser": "node scripts/test-studio-browser.mjs --legacy",
    "test:sse:browser": "node scripts/test-runtime-sse-browser.mjs",
    "test:sse:clients": "node --test examples/water-treatment/sse-clients.test.mjs",
    "test:sse:network": "node scripts/test-runtime-sse-network.mjs",
    "test:sse:proxy": "node scripts/test-runtime-sse-network.mjs --proxy",
    "test:sse:soak": "node scripts/test-runtime-sse-network.mjs --soak",
    "test:sse:soak:proxy": "node scripts/test-runtime-sse-network.mjs --proxy --soak",
    "test:sse:fault:unit": "node --test scripts/sse-fault-proxy.test.mjs",
    "test:oidc:proxy": "node --test scripts/oidc-https-dev-proxy.cases.mjs",
    "test:oidc:lab": "node --test scripts/prepare-oidc-lab.cases.mjs",
    "test:oidc:identity": "node --test scripts/oidc-lab-identity.cases.mjs",
    "test:docker": "node --test scripts/docker-stack.cases.mjs",
    "oidc:lab:identity": "node scripts/oidc-lab-identity.mjs",
    "test:oidc:https:readonly": "node --test scripts/verify-oidc-https-readonly.cases.mjs",
    "test:projects:oidc:config": "node --test scripts/test-project-browser-oidc.cases.mjs",
    "test:oidc:dual:config": "node --test scripts/test-oidc-dual-cas.cases.mjs",
    "test:oidc:dual:preflight": "node scripts/test-oidc-dual-cas.mjs",
    "test:oidc:dual:cas": "node scripts/test-oidc-dual-cas.mjs --run-cas --confirm-lab adui_scada",
    "test:oidc:dual:late": "node scripts/test-oidc-dual-cas.mjs --run-late-response --confirm-lab adui_scada",
    "test:oidc:dual:studio:config": "node --test scripts/test-oidc-studio-real-late.cases.mjs",
    "test:oidc:dual:studio:multitab:config": "node --test scripts/test-oidc-studio-multitab.cases.mjs",
    "test:oidc:dual:studio:multitab": "node scripts/test-oidc-studio-multitab.mjs --run-studio-multitab --confirm-lab adui_scada",
    "test:oidc:dual:studio:late": "node scripts/test-oidc-studio-real-late.mjs --run-studio-late --confirm-lab adui_scada",
    "test:oidc:revoke:config": "node --test scripts/test-oidc-real-acl-revocation.cases.mjs",
    "test:oidc:revoke:preflight": "node scripts/test-oidc-real-acl-revocation.mjs",
    "test:oidc:revoke:browser": "node scripts/test-oidc-real-acl-revocation.mjs --run-revoke --confirm-lab adui_scada",
    "test:projects:oidc:browser": "node scripts/test-project-browser-oidc.mjs",
    "test:projects:oidc:denial": "node scripts/test-project-browser-oidc.mjs --simulate-access-denial",
    "test:projects:oidc:resume": "node scripts/test-project-browser-oidc.mjs --simulate-resume-check",
    "test:projects:oidc:save:browser": "node scripts/test-project-browser-oidc.mjs --simulate-save-timing",
    "test:projects:oidc:browser:pages": "node scripts/test-project-browser-oidc.mjs --require-multipage",
    "oidc:lab:projects:pages": "node scripts/test-project-browser-oidc.mjs --prepare-multipage --confirm-lab adui_scada",
    "verify:oidc:https:readonly": "node scripts/verify-oidc-https-readonly.mjs",
    "test:sse:fault:browser": "node scripts/test-runtime-sse-browser.mjs --transport-fault",
    "test:sse:fault:proxy": "node scripts/test-runtime-sse-browser.mjs --transport-fault --docker",
    "test:interop": "node scripts/test-studio-browser.mjs --interop",
    "test:versions": "node scripts/test-studio-browser.mjs --versions",
    "test:versions:safety": "node scripts/test-studio-browser.mjs --versions-safety",
    "test:multitab": "node scripts/test-studio-browser.mjs --multitab",
    "test:core": "pnpm run build:core && vp test run packages/core/test",
    "test:runtime": "pnpm run build:core && vp test run packages/runtime/test",
    "deps:check": "node scripts/check-dependency-catalog.mjs",
    "docs:check": "node scripts/validate-docs.mjs",
    "ready": "pnpm run deps:check && pnpm run config:check && pnpm run env:check && pnpm run messages:check && pnpm run db:generate && pnpm run build:core && vp check && pnpm run typecheck:web && pnpm run typecheck:server && pnpm run test:unit && pnpm run test:sse:clients && pnpm run test:sse:fault:unit && pnpm run test:oidc:proxy && pnpm run test:oidc:lab && pnpm run test:oidc:identity && pnpm run test:docker && pnpm run test:docker:db && pnpm run test:oidc:https:readonly && pnpm run test:projects:oidc:config && pnpm run test:oidc:dual:config && pnpm run test:oidc:dual:studio:config && pnpm run test:oidc:dual:studio:multitab:config && pnpm run test:oidc:revoke:config && pnpm run test:e2e:server && pnpm run docs:check && pnpm run build:web && pnpm run build:server",
    "prepare": "pnpm run build:core && vp config",
    "dev:server": "pnpm --filter @adui/scada-server run start:dev",
    "build:server": "pnpm --filter @adui/scada-server run build",
    "typecheck:server": "pnpm --filter @adui/scada-server run typecheck",
    "test:server": "pnpm --filter @adui/scada-server run test",
    "test:e2e:server": "pnpm --filter @adui/scada-server run test:e2e",
    "desktop:dev:react": "pnpm --filter @adui/scada-desktop run dev:react",
    "desktop:dev:vue": "pnpm --filter @adui/scada-desktop run dev:vue",
    "desktop:build:react": "pnpm --filter @adui/scada-desktop run build:react",
    "desktop:build:vue": "pnpm --filter @adui/scada-desktop run build:vue",
    "config:check": "node scripts/check-shared-config.mjs",
    "desktop:build:react:msi": "pnpm --filter @adui/scada-desktop run build:react:msi",
    "desktop:build:vue:msi": "pnpm --filter @adui/scada-desktop run build:vue:msi",
    "env:check": "node scripts/check-env-config.mjs",
    "messages:check": "node scripts/check-chinese-messages.mjs",
    "db:validate": "pnpm --filter @adui/scada-server run db:validate",
    "db:generate": "pnpm --filter @adui/scada-server run db:generate",
    "db:migrate:dev": "pnpm --filter @adui/scada-server run db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @adui/scada-server run db:migrate:deploy",
    "db:migrate:status": "pnpm --filter @adui/scada-server run db:migrate:status",
    "test:db": "pnpm --filter @adui/scada-server run test:db",
    "build:core": "pnpm --filter @adui/scada-core run build:node",
    "test:docker:server": "node scripts/test-server-container.mjs",
    "docker:plan": "pnpm run env:check && node scripts/prepare-oidc-lab.mjs && node scripts/docker-stack.mjs plan",
    "docker:up": "pnpm run env:check && node scripts/prepare-oidc-lab.mjs && node scripts/docker-stack.mjs up && node scripts/init-docker-db.mjs",
    "docker:down": "node scripts/docker-stack.mjs down",
    "docker:ps": "node scripts/docker-stack.mjs ps",
    "docker:logs": "node scripts/docker-stack.mjs logs",
    "test:docker:db": "node --test scripts/init-docker-db.cases.mjs",
    "docker:db:init": "node scripts/init-docker-db.mjs",
    "docker:db:status": "node scripts/init-docker-db.mjs --status"
  },
  "devDependencies": {
    "@adui/tooling": "workspace:*",
    "@adui/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
