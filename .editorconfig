# Single editor baseline for the ADui SCADA monorepo.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,vue,json,jsonc,css,scss,less,html,yaml,yml,toml}]
max_line_length = 100

[*.rs]
indent_size = 4
max_line_length = 100

[*.md]
trim_trailing_whitespace = false

# Native Windows command scripts are the only intentional CRLF exception.
[*.{bat,cmd}]
end_of_line = crlf
