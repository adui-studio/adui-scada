# syntax=docker/dockerfile:1
# 仅包含 NestJS 进程存活检查的最小容器，不是生产 SCADA API。
FROM node:24.22.2-bookworm AS build
WORKDIR /workspace
RUN npm install --global pnpm@12.18.0
COPY . .
RUN pnpm install --frozen-lockfile \
    && pnpm --filter @adui/scada-server run build

FROM node:24.22.2-bookworm-slim
ENV NODE_ENV=production
WORKDIR /workspace
# pnpm Workspace 符号链接指向根目录 .pnpm 存储，因此需要复制两级依赖。
COPY --from=build --chown=node:node /workspace/node_modules/ /workspace/node_modules/
COPY --from=build --chown=node:node /workspace/apps/server/node_modules/ /workspace/apps/server/node_modules/
COPY --from=build --chown=node:node /workspace/apps/server/dist/ /workspace/apps/server/dist/
COPY --from=build --chown=node:node /workspace/apps/server/package.json /workspace/apps/server/package.json
USER node
EXPOSE 3001
CMD ["node", "apps/server/dist/main.js"]
