# syntax=docker/dockerfile:1
# 临时 V0.1 本机模拟器，不属于工业网关或生产数据源。
FROM node:24.22.2-bookworm-slim
ENV NODE_ENV=production
WORKDIR /workspace
COPY --chown=node:node packages/core/package.json packages/core/package.json
COPY --chown=node:node packages/core/src/ packages/core/src/
COPY --chown=node:node examples/water-treatment/ examples/water-treatment/
USER node
EXPOSE 4178
CMD ["node", "examples/water-treatment/server.mjs"]
